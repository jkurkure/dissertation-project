      const printText = () => {
         document.querySelector("h3").style.display = "none";
         var mql = window.matchMedia("(min-aspect-ratio: 4/3)"); if (mql.matches) { var orientation = 'landscape'; }else { var orientation = 'portrait'}
         window.alert("Remember to set your layout to " + orientation + " for best results!");
         window.print();
         document.querySelector("h3").style.display = "block";
      }

      const anchored = (t0, t1) => {
         let anchors = t0.querySelectorAll('span');
         let anchors1 = t1.querySelectorAll('span');
         for (let i = 0; i < anchors.length; i++) {
            for (let j = 0; j < anchors1.length; j++) {
               if (anchors[i].innerHTML == anchors1[j].innerHTML) {
                  return true;
               }
            }
         }
         return false;
      }

      const hieroSize = () => {
         return parseInt(getComputedStyle(document.querySelector("table#text")).fontSize)*(localStorage.getItem("ratio") || 1.5);
      }

      if (localStorage.getItem("fontsize") != null) {
         document.querySelector("table#text").style.fontSize = localStorage.getItem("fontsize") + "px";
      }
      document.querySelector("#fontsize").value = parseInt(getComputedStyle(document.querySelector("table#text")).fontSize);
      document.querySelector("#ratio").value = hieroSize() / document.querySelector("#fontsize").value;
      var hiero = true;
      var hieroURL = "";
      window.onresize = function(){ location.href = "#{currentURL}/"; };
      localStorage.setItem("text-url", "#{textUrl}");
      var xmlhttp = new window.XMLHttpRequest();
      xmlhttp.open("GET", localStorage.getItem("text-url"), true);
      xmlhttp.send(null);
      xmlhttp.onreadystatechange = callbackFunction;
      const RESOURCE_LOADING_TIME = 500;

      function callbackFunction() {
         if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
            var response = xmlhttp.responseText;
            var parser = new DOMParser();
            var xmlDoc = parser.parseFromString(response, "text/xml");
            var corpus_type = xmlDoc.getElementsByTagName("text")[0].getAttribute("description");
            document.getElementById("info").innerHTML = corpus_type;
            //check if hiero is included in the corpus type
            hiero = corpus_type.includes("hiero");
            let reslinks = xmlDoc.getElementsByTagName("resource");
            for (let i = 0; i < reslinks.length; i++) {
               if (reslinks[i].getAttribute("location").includes("Hi")) {
                  hieroURL = reslinks[i].getAttribute("location").replace("..", "/corpus");
               }
            }

            //populate table with information of books
            var books = document.getElementById("books");
            books.innerHTML = "<tr><th>Books</th></tr>";
            var data = xmlDoc.getElementsByTagName("collection");

            //loop through data to find all tags with attribute kind="book"
            for (var i = 0; i < data.length; i++) {
               if (data[i].getAttribute("kind") == "books") {
                  var row = books.insertRow(1);
                  var cell = row.insertCell(0);
                  cell.innerHTML = data[i].getAttribute("collect");
               }
            }

            //populate table with information of kings
            var kings = document.getElementById("kings");

            kings.innerHTML = "<tr><th>Kings</th></tr>";
            var data = xmlDoc.getElementsByTagName("collection");
            
            //loop through data to find all tags with attribute kind="king"
            for (var i = 0; i < data.length; i++) {
               if (data[i].getAttribute("kind") == "kings") {
                  var row = kings.insertRow(1);
                  var cell = row.insertCell(0);
                  cell.innerHTML = data[i].getAttribute("collect");
               }
            }
         }
      }

